{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build:types": {
      "dependsOn": [],
      "outputs": [".types/**"]
    },
    "typecheck": {
      "dependsOn": ["^build:types"],
      "outputs": []
    },
    "lint": {
      "cache": false,
      "outputs": []
    },
    "test": {
      "dependsOn": [],
      "outputs": []
    },
    "//#fallow:check": {
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}
