{
  "name": "boop-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Text-an-agent starter: iMessage your Claude agent, it runs sub-agents, remembers you, and grows with integrations you add.",
  "license": "MIT",
  "type": "module",
  "workspaces": ["packages/*", "apps/*", "convex"],
  "scripts": {
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "deploy:convex": "convex deploy",
    "setup": "bun scripts/setup.ts",
    "fallow": "fallow",
    "fallow:baseline": "fallow --save-regression-baseline",
    "fallow:check": "bun scripts/fallow-check.ts",
    "lint-staged": "lint-staged",
    "prepare": "husky"
  },
  "lint-staged": {
    "packages/shared/src/**/*.ts": ["biome check --write"],
    "apps/worker/src/**/*.ts": ["biome check --write"],
    "apps/dashboard/src/**/*.{ts,tsx}": ["biome check --write"]
  },
  "dependencies": {
    "convex": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@types/node": "^22.0.0",
    "fallow": "^2.52.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "turbo": "^2.9.6",
    "typescript": "^5.6.0"
  },
  "catalog": {
    "agents": "0.11.5",
    "convex": "^1.36.1",
    "hono": "^4.12.14",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.0",
    "zod": "^4.3.6"
  },
  "overrides": {
    "@rolldown/pluginutils": "1.0.0-rc.16"
  },
  "packageManager": "bun@1.3.12",
  "engines": {
    "node": ">=20"
  }
}
