{
  "name": "boop-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Text-an-agent starter: iMessage your Claude agent, it runs sub-agents, remembers you, and grows with integrations you add.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "setup": "bun scripts/setup.ts",
    "cf-typegen": "wrangler types",
    "typecheck": "bun run cf-typegen && tsc --noEmit",
    "lint": "biome check --write src/",
    "fallow": "fallow",
    "fallow:baseline": "fallow --save-regression-baseline",
    "fallow:check": "bun scripts/fallow-check.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:convex": "convex dev",
    "deploy:convex": "convex deploy",
    "build:debug": "vite build --config debug/vite.config.ts",
    "lint-staged": "lint-staged",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "biome check --write",
      "biome format --write"
    ]
  },
  "dependencies": {
    "@agentic/serper": "^8.4.4",
    "@ai-sdk/openai-compatible": "^2.0.41",
    "@cloudflare/codemode": "^0.3.4",
    "@composio/core": "^0.6.11",
    "@hono/zod-validator": "^0.7.6",
    "@hugeicons/core-free-icons": "^1.0.0",
    "@hugeicons/react": "^1.0.0",
    "agents": "0.11.5",
    "ai": "^6.0.168",
    "convex": "^1.36.1",
    "croner": "^10.0.1",
    "hono": "^4.12.14",
    "libphonenumber-js": "^1.12.42",
    "node-html-markdown-cloudflare": "^1.3.0",
    "react-force-graph-2d": "^1.27.0",
    "remove-markdown": "^0.6.3",
    "sendblue": "^3.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^3.0.8",
    "@biomejs/biome": "^2.4.12",
    "@cloudflare/vitest-pool-workers": "0.14.9",
    "@cloudflare/workers-types": "^4.20260426.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/prompts": "^2.4.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "fallow": "^2.52.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prompts": "^2.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.5",
    "wrangler": "4.84.1"
  },
  "overrides": {
    "@rolldown/pluginutils": "1.0.0-rc.16"
  },
  "engines": {
    "node": ">=20"
  }
}
