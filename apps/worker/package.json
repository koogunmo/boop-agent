{
  "name": "@boop/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./.types/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "wrangler types && tsc --noEmit",
    "lint": "biome check --write src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "bun run build:types && wrangler deploy --dry-run",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@boop/shared": "workspace:*",
    "@boop/convex": "workspace:*",
    "@agentic/serper": "^8.4.4",
    "@ai-sdk/openai-compatible": "^2.0.41",
    "@cloudflare/codemode": "^0.3.4",
    "@composio/core": "^0.6.11",
    "@hono/zod-validator": "^0.7.6",
    "agents": "catalog:",
    "ai": "^6.0.168",
    "convex": "catalog:",
    "croner": "^10.0.1",
    "hono": "catalog:",
    "libphonenumber-js": "^1.12.42",
    "node-html-markdown-cloudflare": "^1.3.0",
    "partyserver": "^0.4.1",
    "remove-markdown": "^0.6.3",
    "sendblue": "^3.7.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^3.0.8",
    "@cloudflare/vitest-pool-workers": "0.14.9",
    "@cloudflare/workers-types": "^4.20260426.1",
    "vitest": "^4.1.5",
    "wrangler": "4.84.1"
  }
}
